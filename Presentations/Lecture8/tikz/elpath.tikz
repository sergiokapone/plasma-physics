\newcommand{\midarrow}{\tikz \draw[-latex] (0,0) -- +(.1,0);}


%---------------------------------------------------------
\begin{minipage}[c]{0.5\linewidth}\centering
    \begin{tikzpicture}[scale=0.5]
    \pgfmathsetseed{3}
    \foreach \x in {1,...,4} {
        \foreach \y in {1,...,3} {
            \node[circle, ball color=red, inner sep=2pt] (\x-\y) at ({\x+rnd}, {\y+0.5*rnd}) {};
        }
    }
\draw (-1, 2) -- node[sloped] {\midarrow} (1-1.north)
-- node[sloped] {\midarrow} (2-3.south)
-- node[sloped] {\midarrow} (3-2.north)
-- node[sloped]
{\midarrow} (4-3.south)
-- node[sloped]
{\midarrow} ++(-30:3);
\end{tikzpicture}
\end{minipage}%
%---------------------------------------------------------
\begin{minipage}[c]{0.5\linewidth}\centering

\begin{tikzpicture}[scale=0.5, >=latex,
]
    \pgfmathsetseed{6}
    \foreach \x in {1,...,4} {
        \foreach \y in {1,...,2} {
            \node[circle, ball color=blue, inner sep=0pt, text=white, font=\scriptsize] (\x-\y) at ({2*\x+0.5*rnd}, {2*\y+1*rnd}) {+};
             \draw[dashed, ultra thin] (\x-\y) circle (1);
            \node[circle, ball color=red, inner sep=0pt, text=white, font=\scriptsize] (e-\x-\y) at ({2*\x+1*rnd}, {2*\y+2*rnd}) {\tikz {\draw[thick]
            (0,0) -- ++(0.1,0);} };
        }
    }

%\draw[gray!50, step=1cm] (0, 0) grid[] (10, 6);
\draw[-latex] plot [smooth] coordinates { (0, 4.2) (4.2, 3.3) (6, 4) (7.5, 6) };
\draw[dashed, <->, gray!50] (0, 4.2) -- node[sloped, above, text=black] {$\ell$} (7.5, 6);
\end{tikzpicture}
\end{minipage}
