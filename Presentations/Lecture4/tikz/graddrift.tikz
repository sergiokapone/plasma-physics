\begin{tikzpicture}[
    declare function = {
    R = 0.5;
    dR = 0.05;
    x(\t)=(1-(R+dR*\t)*cos(\t r));
    y(\t)=(R+dR*\t)*sin(\t r);
    },
]
    \draw[-latex] (0, 0) -- ++(0, 2) node[right] {$y$};
    \draw[-latex] (0, 0) -- ++(4, 0) node[below] {$x$};
    \draw[-latex] (0, 0) -- ++(-135:1.75) node[below right] {$z$};

    \draw[->, blue] (0, 0) -- ++(-135:1.25) node[above left, text=blue] {$\vec{B}$};

    \foreach \y in {1, 1.5, 1.8, 2}{
    \draw[->, blue!80, opacity=0.5] (0, \y) -- ++(-135:1.25);
    }

    \draw[->, gray, thick] (0, 0) -- ++(0, 1.5) node[left, text=gray] {$\vec\nabla B$};


    \draw[blue, samples=100, domain=0:2*pi, variable=\t,
    decoration={
        markings,
        mark=at position 0.85 with {\arrow{latex}},
        },
        postaction={decorate}
    ] plot ( {x(\t)}, {y(\t)});

    \node[circle, ball color=blue, inner sep=0, text=white] at ({x(pi/2)}, {y(pi/2)}) {$+$};

    \draw[thick, -latex] (1,0) -- node[below, font=\scriptsize] {$\vec{v}_{\nabla B}$} ++(-0.5,0);

        \draw[red, samples=100, domain=0:2*pi, variable=\t,
%        xscale=-0.5, yscale=0.5,
        decoration={
            markings,
            mark=at position 0.6 with {\arrow[xshift=2pt]{latex}},
            },
            postaction={decorate}
        ] plot ( {3-0.5*x(\t)}, {0.5*y(\t)});

        \node[circle, ball color=red, inner sep=0.5pt, text=white] at ({3-0.5*x(pi/2)}, {0.5*y(pi/2)}) {\tikz\draw[] (0,0) -- (0.1,0);};

        \draw[thick, -latex] (2.5,0) --  node[anchor=north west, font=\scriptsize] {$\vec{v}_{\nabla B}$} ++(0.5,0);
\end{tikzpicture}