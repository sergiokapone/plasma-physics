\begin{tikzpicture}[>=latex']
	% (а) beta << 1
	\begin{scope}
		\fill[red!30] (0,0) rectangle (0.9,0.25);
		\fill[blue!30] (1.2,0) rectangle (2.1,2.4);
		\draw (0,0) -- (2.3,0);
		\node[font=\scriptsize] at (0.45,-0.28) {$p$};
		\node[font=\scriptsize] at (1.65,-0.28) {$B^2/8\pi$};
		\node[font=\footnotesize] at (1.15,-0.8) {$\beta\ll1$};
	\end{scope}
	% (б) beta ~ 1
	\begin{scope}[xshift=3.5cm]
		\fill[red!30] (0,0) rectangle (0.9,1.3);
		\fill[blue!30] (1.2,0) rectangle (2.1,1.4);
		\draw (0,0) -- (2.3,0);
		\node[font=\scriptsize] at (0.45,-0.28) {$p$};
		\node[font=\scriptsize] at (1.65,-0.28) {$B^2/8\pi$};
		\node[font=\footnotesize] at (1.15,-0.8) {$\beta\sim1$};
	\end{scope}
	% (в) beta > 1 (поле майже не утримує)
	\begin{scope}[xshift=7cm]
		\fill[red!30] (0,0) rectangle (0.9,2.4);
		\fill[blue!30] (1.2,0) rectangle (2.1,0.4);
		\draw (0,0) -- (2.3,0);
		\node[font=\scriptsize] at (0.45,-0.28) {$p$};
		\node[font=\scriptsize] at (1.65,-0.28) {$B^2/8\pi$};
		\node[font=\footnotesize] at (1.15,-0.8) {$\beta\gtrsim1$};
	\end{scope}
\end{tikzpicture}
