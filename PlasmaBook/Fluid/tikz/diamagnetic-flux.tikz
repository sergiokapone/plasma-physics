\begin{tikzpicture}[>=latex']
	% градієнт густини: праворуч частинок більше
	\shade[left color=white, right color=blue!25] (-2.2,-1.8) rectangle (2.2,1.8);
	\draw[->] (-2.4,-1.8) -- (2.6,-1.8) node[right] {$x$};
	% площина x = x0
	\draw[dashed, thick] (0,-1.8) -- (0,1.9) node[above, font=\footnotesize] {$x=x_0$};
	% орбіти з центрами праворуч: у площині x0 частинка рухається вгору (за годинниковою стрілкою)
	\foreach \yc in {-1.0, 0.0, 1.0} {
		\draw[blue!70!black, thick, decoration={markings, mark=at position 0.5 with {\arrow{latex}}}, postaction={decorate}]
			(0,\yc) arc[start angle=180, delta angle=-360, radius=0.5, x radius=0.5, y radius=0.5] ;
	}
	% орбіти з центрами ліворуч (менше): в площині x0 частинка рухається вниз
	\foreach \yc in {-0.5, 0.5} {
		\draw[red!70!black, thick, decoration={markings, mark=at position 0.5 with {\arrow{latex}}}, postaction={decorate}]
			(0,\yc) arc[start angle=0, delta angle=-360, radius=0.5];
	}
	% стрілки потоків
	\draw[->, very thick, blue!70!black] (0.15,0.9) -- (0.15,1.5);
	\draw[->, very thick, red!70!black] (-0.15,0.7) -- (-0.15,0.3);
	\node[font=\scriptsize, anchor=west] at (1.3,1.2) {більше частинок};
	\node[font=\scriptsize, anchor=east] at (-1.3,-1.2) {менше};
	\draw[->, very thick] (2.0,-0.6) -- (2.0,0.7) node[midway, right, font=\scriptsize] {$j_y$};
\end{tikzpicture}
