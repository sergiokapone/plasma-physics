\begin{tikzpicture}[x=1.1cm, y=1.1cm, font=\footnotesize]
    % осі (вертикальна вісь обрізана: показано лише околицю B_0)
    \draw[-latex] (-2.2,0) -- (2.4,0) node[below] {$x$};
    \draw[-latex] (0,0) -- (0,3.0) node[above] {$B_z$};
    % дефіцит потоку
    \fill[orange!40] (-1,2) -- plot[domain=-1:1, samples=40] (\x, {0.5+1.5*\x*\x}) -- (1,2) -- cycle;
    % профіль поля
    \draw[blue!70!black, very thick] (-2.2,2) -- (-1,2);
    \draw[blue!70!black, very thick, domain=-1:1, samples=40] plot (\x, {0.5+1.5*\x*\x});
    \draw[blue!70!black, very thick] (1,2) -- (2.2,2);
    % позначки
    \draw[dashed, gray] (0,2) -- (-2.2,2);
    \node[left] at (-2.2,2) {$B_0$};
    \draw (-1,0.05) -- (-1,-0.05) node[below] {$-a$};
    \draw (1,0.05) -- (1,-0.05) node[below] {$a$};
    \node[anchor=south] at (0,2.15) {$\Delta\Phi\propto\int p\,dS$};
    \node[font=\scriptsize, anchor=north] at (0,-0.1) {плазма};
\end{tikzpicture}
