\begin{tikzpicture}[>=latex']
	% (а) z-пінч: струм вздовж осі, азимутальне поле
	\begin{scope}
		\draw[thick, fill=blue!10] (-0.9,0) -- (-0.9,3) arc[start angle=180, end angle=0, x radius=0.9, y radius=0.3]
			-- (0.9,0) arc[start angle=0, end angle=-180, x radius=0.9, y radius=0.3] -- cycle;
		\draw[thick] (-0.9,3) arc[start angle=180, end angle=360, x radius=0.9, y radius=0.3];
		\draw[->, very thick, red!70!black] (0,-0.9) -- (0,3.6) node[above, font=\footnotesize] {$J$};
		\foreach \yy in {0.9,2.1} {
			\draw[->, thick, blue!70!black] (1.3,\yy) arc[start angle=0, end angle=170, x radius=1.3, y radius=0.4];
			\draw[thick, blue!70!black] (1.3,\yy) arc[start angle=0, end angle=-90, x radius=1.3, y radius=0.4];
		}
		\node[font=\footnotesize, blue!70!black] at (1.75,2.25) {$B_\theta$};
		\node[font=\footnotesize] at (0,-1.4) {(а) $z$-пінч};
	\end{scope}
	% (б) theta-пінч: поле вздовж осі, кільцеві струми
	\begin{scope}[xshift=5.5cm]
		\draw[thick, fill=blue!10] (-0.9,0) -- (-0.9,3) arc[start angle=180, end angle=0, x radius=0.9, y radius=0.3]
			-- (0.9,0) arc[start angle=0, end angle=-180, x radius=0.9, y radius=0.3] -- cycle;
		\draw[thick] (-0.9,3) arc[start angle=180, end angle=360, x radius=0.9, y radius=0.3];
		\draw[->, very thick, blue!70!black] (0,-0.9) -- (0,3.6) node[above, font=\footnotesize] {$B_z$};
		\foreach \yy in {0.8,1.5,2.2} {
			\draw[red!70!black, thick, ->] (-0.85,\yy) arc[start angle=180, end angle=330, x radius=0.85, y radius=0.25];
			\draw[red!70!black, thick] (-0.85,\yy) arc[start angle=180, end angle=90, x radius=0.85, y radius=0.25];
		}
		\node[font=\footnotesize, red!70!black] at (1.5,1.5) {$j_\theta$};
		\node[font=\footnotesize] at (0,-1.4) {(б) $\theta$-пінч};
	\end{scope}
\end{tikzpicture}
