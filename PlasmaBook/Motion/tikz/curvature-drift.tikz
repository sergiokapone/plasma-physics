\begin{tikzpicture}[>=latex']
	% силова лінія з радіусом кривизни
	\draw[blue!70!black, very thick, decoration={markings, mark=at position 0.62 with {\arrow{latex}}}, postaction={decorate}]
		(150:2.4) arc[start angle=150, end angle=30, radius=2.4];
	\draw[blue!40, thick, decoration={markings, mark=at position 0.62 with {\arrow{latex}}}, postaction={decorate}]
		(150:2.0) arc[start angle=150, end angle=30, radius=2.0];
	\draw[blue!40, thick, decoration={markings, mark=at position 0.62 with {\arrow{latex}}}, postaction={decorate}]
		(150:2.8) arc[start angle=150, end angle=30, radius=2.8];
	% центр кривизни та R_c
	\fill (0,0) circle (1.5pt) node[below] {центр кривизни};
	\draw[->, thick] (0,0) -- (0,2.4) node[pos=0.5, left] {$\vect R_c$};
	% частинка
	\node[circle, ball color=red!70, inner sep=2.2pt, text=white, font=\tiny] at (0,2.4) {$+$};
	% відцентрова сила
	\draw[->, orange!80!black, very thick] (0,2.4) -- (0,3.35) node[above] {$\vect F_c$};
	% B
	\draw[->, blue!70!black, thick] (0,2.4) -- (1.1,2.4) node[right] {$\vect B$};
	% дрейф: з площини / у площину
	\node[draw, circle, inner sep=1pt, font=\scriptsize] (ion) at (-1.7,2.4) {$\times$};
	\node[left=2pt of ion, font=\scriptsize] {$\vect v_R$ (іони)};
	\node[draw, circle, inner sep=0.8pt, font=\scriptsize] (el) at (-1.7,1.5) {$\cdot$};
	\node[left=2pt of el, font=\scriptsize] {$\vect v_R$ (електрони)};
\end{tikzpicture}
