  \node[orange!60!black, font=\small, anchor=west] at (1.9,3.6) {кільце $[b,\,b+db]$};
  \node[font=\small] at (-3.4,-1.6) {$b=b_{90}$: $\theta\sim\pi/2$};
  \node[font=\small] at (-3.4,3.25) {$b\gg b_{90}$: $\theta\approx2b_{90}/b$};
