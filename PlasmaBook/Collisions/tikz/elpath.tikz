\providecommand{\midarrow}{\tikz \draw[-latex] (0,0) -- +(.1,0);}
\begin{minipage}[c]{0.48\linewidth}\centering
	\begin{tikzpicture}[scale=0.45]
		\pgfmathsetseed{3}
		\foreach \x in {1,...,4} {
			\foreach \y in {1,...,3} {
				\node[circle, ball color=red, inner sep=2pt] (a\x-\y) at ({\x+rnd}, {\y+0.5*rnd}) {};
			}
		}
		\draw (-1, 2) -- node[sloped] {\midarrow} (a1-1.north)
		-- node[sloped] {\midarrow} (a2-3.south)
		-- node[sloped] {\midarrow} (a3-2.north)
		-- node[sloped] {\midarrow} (a4-3.south)
		-- node[sloped] {\midarrow} ++(-30:3);
	\end{tikzpicture}

	\small нейтральний газ: ламана лінія з~різкими зіткненнями
\end{minipage}%
\hfill
\begin{minipage}[c]{0.48\linewidth}\centering
	\begin{tikzpicture}[scale=0.45, >=latex]
		\pgfmathsetseed{6}
		\foreach \x in {1,...,4} {
			\foreach \y in {1,...,2} {
				\node[circle, ball color=blue, inner sep=0pt, text=white, font=\scriptsize] (i\x-\y) at ({2*\x+0.5*rnd}, {2*\y+1*rnd}) {+};
				\draw[dashed, ultra thin] (i\x-\y) circle (1);
				\node[circle, ball color=red, inner sep=0pt, text=white, font=\scriptsize] (e\x-\y) at ({2*\x+1*rnd}, {2*\y+2*rnd}) {$-$};
			}
		}
		\draw[-latex] plot [smooth] coordinates { (0, 4.2) (4.2, 3.3) (6, 4) (7.5, 6) };
		\draw[dashed, <->, gray] (0, 4.2) -- node[sloped, above, text=black] {$\ell$} (7.5, 6);
	\end{tikzpicture}

	\small плазма: плавне викривлення далекими прольотами
\end{minipage}
