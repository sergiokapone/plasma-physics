\begin{tikzpicture}[>=latex', scale=1.25]
	% прямі лінії та викривлена лінія в центрі
	\foreach \x in {0,0.7,1.4,3.5,4.2,4.9} {
		\draw[blue!45, thick] (\x,0) -- (\x,3);
	}
	\draw[blue!80!black, very thick, domain=0:3, samples=60, variable=\t] plot ({2.45+0.55*sin(\t*120)},{\t});
	% магнітний тиск: згущені лінії з боку опуклості штовхають її назад
	\draw[->, thick, red!70!black] (3.45,0.75) -- (3.08,0.75);
	\draw[->, thick, red!70!black] (1.45,2.25) -- (1.82,2.25);
	% натяг: викривлена лінія прагне випрямитися
	\draw[->, thick, green!50!black] (3.0,0.75) -- (2.55,0.75);
	\draw[->, thick, green!50!black] (1.9,2.25) -- (2.35,2.25);
	% легенда
	\draw[->, thick, red!70!black] (0.2,-0.4) -- (0.6,-0.4) node[right, font=\footnotesize, black] {тиск $B^2/8\pi$};
	\draw[->, thick, green!50!black] (2.7,-0.4) -- (3.1,-0.4) node[right, font=\footnotesize, black] {натяг $B^2/4\pi R_c$};
\end{tikzpicture}
