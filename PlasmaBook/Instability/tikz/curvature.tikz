\begin{tikzpicture}[>=latex, font=\small]
	\foreach \xs in {0, 6.2} {
		\begin{scope}[xshift=\xs cm]
			\fill[orange!25] (0,0) rectangle (5,1.6);
			\node[font=\scriptsize] at (0.9,0.3) {плазма};
			\node[font=\scriptsize] at (0.9,2.9) {вакуум};
			\draw[thin] (0,1.6) -- (5,1.6);
		\end{scope}
	}
	% погана кривина: лінія вигнута в бік вакууму (центр кривини в плазмі)
	\draw[blue!70!black, very thick] (0.3,1.6) .. controls (1.5,3.1) and (3.5,3.1) .. (4.7,1.6);
	\draw[->, thick, red!70!black] (2.5,2.7) -- (2.5,1.9) node[midway, right, font=\scriptsize] {$\boldsymbol\kappa$};
	\draw[->, thick, green!50!black] (3.6,1.3) -- (3.6,0.5) node[midway, right, font=\scriptsize] {$\nabla p$};
	\draw[->, thick, gray!60!black] (4.1,2.25) -- (4.1,2.85) node[above, font=\scriptsize] {$g_{\rm eff}$};
	\node[font=\scriptsize\bfseries, text width=5cm, align=center] at (2.5,-0.6) {погана кривина:\ $\nabla p\cdot\boldsymbol\kappa>0$};
	% хороша кривина: лінія вигнута в бік плазми (центр кривини у вакуумі)
	\draw[blue!70!black, very thick] (6.5,1.6) .. controls (7.7,0.1) and (9.7,0.1) .. (10.9,1.6);
	\draw[->, thick, red!70!black] (8.7,0.5) -- (8.7,1.2) node[midway, right, font=\scriptsize] {$\boldsymbol\kappa$};
	\draw[->, thick, green!50!black] (10.3,1.3) -- (10.3,0.5) node[midway, right, font=\scriptsize] {$\nabla p$};
	\node[font=\scriptsize\bfseries, text width=5cm, align=center] at (8.7,-0.6) {хороша кривина:\ $\nabla p\cdot\boldsymbol\kappa<0$};
\end{tikzpicture}
