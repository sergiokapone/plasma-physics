\begin{tikzpicture}[>=latex', node distance=7mm,
	esrc/.style={draw, rounded corners, fill=orange!15, align=center, font=\footnotesize, minimum width=2.7cm, minimum height=0.8cm},
	emid/.style={draw, rounded corners, fill=blue!10, align=center, font=\footnotesize, minimum width=2.4cm, minimum height=1.4cm},
	eout/.style={draw, rounded corners, fill=green!15, align=center, font=\footnotesize, minimum width=2.7cm, minimum height=1.4cm}]
	\node[esrc] (a) at (0,1.65) {градієнт тиску / густини};
	\node[esrc] (b) at (0,0.55) {струм у~плазмі};
	\node[esrc] (c) at (0,-0.55) {анізотропія розподілу};
	\node[esrc] (d) at (0,-1.65) {пучок частинок};
	\node[emid] (m) at (5.0,0) {мале\\збурення};
	\node[eout] (o) at (9.6,0) {енергія руху\\та~поля\\(ріст $e^{\gamma t}$)};
	\foreach \s in {a,b,c,d} \draw[->, thick] (\s.east) -- (m.west);
	\draw[->, ultra thick] (m.east) -- (o.west) node[midway, above, font=\scriptsize] {$\gamma>0$};
	\node[font=\footnotesize, align=center] at (0,2.45) {\bfseries вільна енергія рівноваги};
\end{tikzpicture}
