\begin{tikzpicture}
	\begin{axis}[
		width=0.95\linewidth, height=0.5\linewidth,
		axis lines=middle, xmin=-3.4, xmax=9, ymin=0, ymax=0.48,
		xlabel={$v$}, ylabel={$F_0(v)$},
		every axis x label/.style={at={(current axis.right of origin)},anchor=west},
		every axis y label/.style={at={(current axis.north west)},above=2mm},
		xtick=\empty, ytick=\empty, clip=false]
		\addplot[very thick, blue!70!black, domain=-3.4:9, samples=200] {0.3989*exp(-x^2/2)+0.035*exp(-(x-5)^2/(2*0.49))};
		% ділянка F' > 0 (висхідна ділянка пучка)
		\addplot[draw=none, fill=green!35, domain=3.7:5.0, samples=40] {0.3989*exp(-x^2/2)+0.035*exp(-(x-5)^2/(2*0.49))} \closedcycle;
		\draw[dashed] (axis cs:4.4,0) -- (axis cs:4.4,0.2);
		\node[font=\footnotesize, anchor=south] at (axis cs:4.4,0.2) {$v_\varphi$};
		\node[font=\footnotesize, align=center, anchor=south west] at (axis cs:5.9,0.1) {$F_0'(v_\varphi)>0$:\\$\gamma>0$ (нестійкість)};
		\node[font=\footnotesize, anchor=west] at (axis cs:0.9,0.38) {максвеллівське тіло};
		\draw[gray] (axis cs:5.0,0.045) -- (axis cs:5.6,0.07) node[right, font=\footnotesize, black] {пучок};
	\end{axis}
\end{tikzpicture}
