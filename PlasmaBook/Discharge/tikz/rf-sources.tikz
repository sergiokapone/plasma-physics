\begin{tikzpicture}[>=latex', font=\footnotesize]
	% (a) CCP
	\begin{scope}
		\fill[gray!60] (0,2.6) rectangle (3.4,2.8);
		\fill[gray!60] (0.6,0.2) rectangle (2.8,0.4);
		\fill[violet!20] (0.1,0.7) rectangle (3.3,2.35);
		\node at (1.7,1.5) {плазма};
		\draw (1.7,2.8) -- (1.7,3.1) node[above] {$\perp$};
		\draw (1.7,0.2) -- (1.7,-0.1);
		\draw (1.4,-0.1) -- (2.0,-0.1); \draw (1.4,-0.25) -- (2.0,-0.25);
		\draw (1.7,-0.25) -- (1.7,-0.5);
		\draw (1.7,-0.75) circle (0.25) node {$\sim$};
		\node[right] at (2.0,-0.17) {$C_b$};
		\draw[gray!70!black] (2.6,0.55) -- (3.2,0.3) node[right, inner sep=1pt] {шар};
		\node at (1.7,-1.35) {(а) ЄЗП};
	\end{scope}
	% (b) ICP
	\begin{scope}[xshift=4.3cm]
		\fill[blue!15] (0,2.4) rectangle (3.4,2.6);
		\foreach \x in {0.4,1.0,1.6,2.2,2.8} \draw[thick, orange!80!black] (\x+0.1,2.85) circle (0.12);
		\node[above] at (1.7,2.95) {котушка};
		\fill[violet!30] (0.1,0.7) rectangle (3.3,2.35);
		\fill[violet!45] (0.1,1.9) rectangle (3.3,2.35);
		\node[right] at (3.3,2.12) {$\delta$};
		\node at (1.7,1.3) {плазма};
		\fill[gray!60] (0.6,0.2) rectangle (2.8,0.4);
		\draw (1.7,0.2) -- (1.7,-0.5);
		\draw (1.7,-0.75) circle (0.25) node {$\sim$};
		\node[right] at (1.95,-0.75) {зміщення};
		\node at (1.7,-1.35) {(б) ІЗП};
	\end{scope}
	% (c) ECR / helicon
	\begin{scope}[xshift=8.8cm]
		\draw[thick] (0,0.7) rectangle (3.4,2.35);
		\fill[violet!20] (0.05,0.75) rectangle (3.35,2.3);
		\foreach \x in {0.3,0.9,2.5,3.1} {\draw[thick, orange!80!black] (\x,2.5) rectangle (\x+0.3,2.75);
			\draw[thick, orange!80!black] (\x,0.3) rectangle (\x+0.3,0.55);}
		\draw[->, thick, red!70!black] (-0.6,1.5) -- (0.4,1.5) node[pos=0, above right] {$\omega$};
		\draw[->, blue!70!black] (0.6,1.1) -- (3.0,1.1) node[pos=0.8, below] {$\vect B$};
		\draw[dashed, green!50!black, thick] (1.9,0.75) -- (1.9,2.3);
		\node[anchor=south west, green!50!black, inner sep=1pt] at (1.95,1.6) {$\omega=\omega_{ce}$};
		\node at (1.7,-1.35) {(в) ЕЦР/гелікон};
	\end{scope}
\end{tikzpicture}
