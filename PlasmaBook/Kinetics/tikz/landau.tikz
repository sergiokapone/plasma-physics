\begin{tikzpicture}
	\begin{axis}[
		width=0.95\linewidth, height=0.5\linewidth,
		axis lines=middle, xmin=-3.4, xmax=4.4, ymin=0, ymax=0.48,
		xlabel={$v$}, ylabel={$F_0(v)$},
		every axis x label/.style={at={(current axis.right of origin)},anchor=west},
		every axis y label/.style={at={(current axis.north west)},above=2mm},
		xtick=\empty, ytick=\empty, clip=false]
		\addplot[very thick, blue!70!black, domain=-3.4:4.4, samples=100] {0.3989*exp(-x^2/2)};
		% заливка: повільніші та швидші за хвилю
		\addplot[draw=none, fill=orange!35, domain=1.0:1.8, samples=40] {0.3989*exp(-x^2/2)} \closedcycle;
		\addplot[draw=none, fill=green!30, domain=2.2:3.0, samples=40] {0.3989*exp(-x^2/2)} \closedcycle;
		\draw[dashed] (axis cs:2,0) -- (axis cs:2,0.46);
		\node[font=\footnotesize, anchor=south] at (axis cs:2,0.46) {$v_\varphi=\omega/k$};
		\node[font=\footnotesize, align=center, anchor=south] (sl) at (axis cs:1.42,0.24) {частинок\\більше:\\\textcolor{orange!70!black}{набирають}\\енергію};
		\node[font=\footnotesize, align=center, anchor=south west] (fs) at (axis cs:2.75,0.12) {частинок менше:\\\textcolor{green!40!black}{віддають}};
		\draw[thin, green!40!black] (fs.south west) -- (axis cs:2.6,0.01);
		\node[font=\footnotesize] at (axis cs:-2.2,0.42) {$F_0'(v_\varphi)<0$ $\Rightarrow$ $\gamma<0$};
	\end{axis}
\end{tikzpicture}
