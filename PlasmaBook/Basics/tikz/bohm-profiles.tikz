\begin{tikzpicture}
	\begin{axis}[
		width=0.72\linewidth, height=0.34\linewidth,
		axis lines=left, xmin=0, xmax=6, ymin=0, ymax=1.12,
		xlabel={$x$ (до стінки)}, ylabel={$n/n_0$},
		every axis x label/.style={at={(current axis.right of origin)},anchor=west},
		xtick={3.7}, xticklabels={межа шару}, ytick={0.61,1}, yticklabels={$0{,}61$,$1$},
		label style={font=\small}, ticklabel style={font=\small},
		clip=false]
		% передшар: n_i = n_e = exp(-chi), chi = 0.5 (x/3.7)^2
		\addplot[very thick, black!70, domain=0:3.7, samples=40] {exp(-0.5*(x/3.7)^2)};
		% шар: електрони за Больцманом, іони за збереженням потоку
		\addplot[very thick, red!70!black, domain=3.7:5.9, samples=60]
			{exp(-(0.5+0.55*(exp((x-3.7)/1.2)-1)))};
		\addplot[very thick, blue!70!black, domain=3.7:5.9, samples=60]
			{0.6065/sqrt(1+2*0.55*(exp((x-3.7)/1.2)-1))};
		\draw[dashed] (axis cs:3.7,0) -- (axis cs:3.7,1.05);
		\fill[pattern=north east lines, pattern color=gray] (axis cs:5.9,0) rectangle (axis cs:6,1.12);
		\node[font=\footnotesize, align=center] at (axis cs:1.6,0.62) {передшар\\$n_i=n_e$};
		\node[font=\footnotesize, blue!70!black, anchor=west] at (axis cs:4.3,0.52) {$n_i$};
		\node[font=\footnotesize, red!70!black, anchor=west] at (axis cs:4.7,0.17) {$n_e$};
		\node[font=\footnotesize, anchor=south] at (axis cs:4.8,0.86) {шар: $n_i>n_e$};
	\end{axis}
\end{tikzpicture}
