\begin{tikzpicture}
\begin{axis}[
    width=0.95\linewidth, height=0.65\linewidth,
    xlabel={$T$, еВ},
    ylabel={$\alpha(T)$},
    xmin=0, xmax=5,
    ymin=0, ymax=1.05,
    samples=500,
    grid=both,
    minor tick num=1,
    legend style={at={(0.98,0.03)}, anchor=south east, draw=black!40, cells={anchor=west}},
    every axis plot/.append style={smooth},
]

% alpha = (-S + sqrt(S^2 + 4S))/2,  S = (C/n0) * u^{3/2} * exp(-13.6/u)
% C = 3.02e21 (n0 в см^-3, u в еВ)

\addplot[blue!70!black, domain=0.4:4.5]
    {(-(3.02e21/1e15)*x^1.5*exp(-13.6/x)
      + sqrt(((3.02e21/1e15)*x^1.5*exp(-13.6/x))^2
             + 4*(3.02e21/1e15)*x^1.5*exp(-13.6/x)))/2};
\addlegendentry{$n_0=10^{15}\ \text{см}^{-3}$}

\addplot[red!70!black, domain=0.6:4.5]
    {(-(3.02e21/1e17)*x^1.5*exp(-13.6/x)
      + sqrt(((3.02e21/1e17)*x^1.5*exp(-13.6/x))^2
             + 4*(3.02e21/1e17)*x^1.5*exp(-13.6/x)))/2};
\addlegendentry{$n_0=10^{17}\ \text{см}^{-3}$}

\addplot[green!50!black, domain=0.8:4.5]
    {(-(3.02e21/1e19)*x^1.5*exp(-13.6/x)
      + sqrt(((3.02e21/1e19)*x^1.5*exp(-13.6/x))^2
             + 4*(3.02e21/1e19)*x^1.5*exp(-13.6/x)))/2};
\addlegendentry{$n_0=10^{19}\ \text{см}^{-3}$}

% T = I/10
\draw[dashed, gray] (axis cs:1.36,0) -- (axis cs:1.36,1.05);
\node[font=\footnotesize, anchor=south west, black!70] at (axis cs:1.4,0.01) {$T=I/10$};
\end{axis}
\end{tikzpicture}
