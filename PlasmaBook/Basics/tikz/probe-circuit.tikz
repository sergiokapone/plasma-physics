% Схема вимірювання одиночним зондом Ленгмюра
\begin{tikzpicture}[>=latex, font=\small]
	% камера з плазмою
	\fill[violet!12] (0,0) rectangle (5,3);
	\draw[very thick] (0,0) rectangle (5,3);
	\node[font=\footnotesize, violet!60!black] at (1.2,0.5) {плазма};
	\node[font=\footnotesize, align=right, anchor=east] at (-0.15,1.5) {стінка камери\\(опорний\\електрод)};
	% зонд: ізоляційна трубка + оголений кінчик
	\draw[line width=3pt, gray!60] (2.5,3.0) -- (2.5,1.95);
	\draw[thick] (2.5,3.9) -- (2.5,3.0);
	\draw[line width=1.6pt, red!70!black] (2.5,1.95) -- (2.5,1.35);
	\fill[red!70!black] (2.5,1.35) circle (0.07);
	\node[font=\footnotesize, anchor=west] at (2.7,1.55) {зонд};
	\node[font=\footnotesize, anchor=west, gray!60!black] at (2.75,2.5) {ізолятор};
	% зовнішнє коло: зонд -> амперметр -> джерело -> стінка
	\draw (2.5,3.9) -- (2.5,4.5) -- (3.6,4.5);
	\draw (4.2,4.5) -- (6.0,4.5) -- (6.0,4.05);
	\draw (3.9,4.5) circle (0.3) node {A};
	\node[font=\footnotesize, anchor=south] at (3.9,4.85) {амперметр, $I$};
	% джерело змінної напруги
	\draw[thick] (5.75,4.05) -- (6.25,4.05);
	\draw[thick] (5.88,3.85) -- (6.12,3.85);
	\draw (6.0,3.85) -- (6.0,1.5) -- (5.0,1.5);
	\draw[->, thick] (5.6,3.6) -- (6.4,4.3);
	\node[font=\footnotesize, anchor=west, align=left] at (6.35,3.6) {джерело\\напруги $V$};
	% вузол на стінці
	\fill (5.0,1.5) circle (0.06);
	% напрям електронного струму з плазми (схематично)
	\draw[->, red!70!black, dashed] (1.4,1.1) -- (2.3,1.3);
	\draw[->, blue!60!black, dashed] (3.7,1.0) -- (2.75,1.25);
	\node[font=\scriptsize, red!70!black, anchor=east] at (1.4,1.1) {$e^-$};
	\node[font=\scriptsize, blue!60!black, anchor=west] at (3.7,1.0) {іони};
\end{tikzpicture}
