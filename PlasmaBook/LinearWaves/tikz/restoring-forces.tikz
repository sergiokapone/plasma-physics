\begin{tikzpicture}[>=latex', every node/.style={font=\scriptsize}]
	% (а) градієнт тиску: стиснення і розрідження
	\begin{scope}
		\foreach \i in {0,1,...,24} {
			\pgfmathsetmacro{\xx}{0.12*\i + 0.18*sin(\i*30)*0 - 0.0}
			\pgfmathsetmacro{\xs}{0.12*\i - 0.09*sin(\i*15)}
			\foreach \j in {0,1,2,3} {
				\fill[blue!60!black] ({\xs},{0.18*\j}) circle (0.9pt);
			}
		}
		\draw[->, thick, red!70!black] (1.45,0.9) -- ++(-0.7,0);
		\draw[->, thick, red!70!black] (1.55,0.9) -- ++(0.7,0);
		\node at (1.5,1.2) {$-\nabla p$};
		\node[align=center] at (1.5,-0.55) {(а) газовий тиск};
	\end{scope}
	% (б) натяг силових ліній
	\begin{scope}[xshift=4.2cm]
		\foreach \x in {0,0.55,1.1,1.65,2.2,2.75} {
			\draw[blue!50, thick] (\x,-0.1) -- (\x,0.85);
		}
		\draw[blue!70!black, very thick] (1.65,-0.1) .. controls (2.05,0.2) and (2.05,0.5) .. (1.65,0.85);
		\draw[blue!50, thick] (1.65,-0.1) -- (1.65,-0.1);
		\draw[->, thick, red!70!black] (2.0,0.375) -- ++(-0.5,0);
		\node at (2.45,0.5) {натяг};
		\node[align=center] at (1.4,-0.55) {(б) натяг ліній};
	\end{scope}
	% (в) магнітний тиск: лінії згущуються
	\begin{scope}[xshift=8.4cm]
		\foreach \x in {0,0.55,1.0,1.3,1.5,1.7,2.0,2.45,3.0} {
			\draw[blue!50, thick] (\x,-0.1) -- (\x,0.85);
		}
		\draw[->, thick, red!70!black] (1.5,0.95) -- ++(-0.8,0);
		\draw[->, thick, red!70!black] (1.5,0.95) -- ++(0.8,0);
		\node at (1.5,1.25) {$-\nabla\frac{B^2}{8\pi}$};
		\node[align=center] at (1.5,-0.55) {(в) магнітний тиск};
	\end{scope}
\end{tikzpicture}
