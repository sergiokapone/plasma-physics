\begin{tikzpicture}[>=latex', scale=1.35, every node/.style={font=\footnotesize}]
	% (а) градієнт тиску: згущення в центрі, тиск розштовхує частинки
	\begin{scope}
		\foreach \i in {0,1,...,24} {
			\pgfmathsetmacro{\xs}{0.12*\i + 0.2*sin(\i*15)}
			\foreach \j in {0,1,2,3,4} {
				\fill[blue!60!black] ({\xs},{0.2*\j}) circle (1pt);
			}
		}
		\draw[->, thick, red!70!black] (1.35,1.15) -- ++(-0.8,0);
		\draw[->, thick, red!70!black] (1.55,1.15) -- ++(0.8,0);
		\node[anchor=south] at (1.45,1.3) {$-\nabla p$};
		\node[align=center] at (1.45,-0.55) {(а) газовий тиск};
	\end{scope}
	% (б) натяг силових ліній: вигнута лінія випрямляється; стрілки на лініях — напрям B
	\begin{scope}[xshift=4.3cm]
		\foreach \x in {0,0.55,1.1,2.2,2.75} {
			\draw[->, blue!50, thick] (\x,-0.1) -- (\x,1.0);
		}
		\draw[->, blue!70!black, very thick] (1.65,-0.1) .. controls (2.0,0.25) and (2.0,0.65) .. (1.65,1.0);
		\draw[->, thick, red!70!black] (1.9,0.45) -- ++(-0.55,0);
		\node[blue!70!black] at (-0.3,0.45) {$\mathbf B$};
		\node[anchor=south] at (1.65,1.15) {натяг};
		\node[align=center] at (1.4,-0.55) {(б) натяг ліній};
	\end{scope}
	% (в) магнітний тиск: лінії згущуються; стрілки на лініях — напрям B
	\begin{scope}[xshift=8.6cm]
		\foreach \x in {0,0.55,1.0,1.3,1.5,1.7,2.0,2.45,3.0} {
			\draw[->, blue!50, thick] (\x,-0.1) -- (\x,1.0);
		}
		\draw[->, thick, red!70!black] (1.4,1.35) -- ++(-0.8,0);
		\draw[->, thick, red!70!black] (1.6,1.35) -- ++(0.8,0);
		\node[blue!70!black] at (-0.3,0.45) {$\mathbf B$};
		\node[anchor=south] at (1.5,1.5) {$-\nabla\dfrac{B^2}{8\pi}$};
		\node[align=center] at (1.5,-0.55) {(в) магнітний тиск};
	\end{scope}
\end{tikzpicture}
