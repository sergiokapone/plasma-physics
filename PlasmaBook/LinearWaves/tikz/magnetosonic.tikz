\begin{tikzpicture}[>=latex']
	% силові лінії B0 (вертикальні), зміщені: лінії та плазма стискаються разом
	\foreach \i in {0,1,...,13} {
		\pgfmathsetmacro{\xs}{0.46*\i - 0.55*sin(\i*27.7)}
		\draw[blue!55, thick] (\xs,0) -- (\xs,1.5);
		\foreach \j in {1,3,5,7,9,11,13} {
			\fill[black!70] ({\xs + 0.06},{0.1*\j}) circle (0.9pt);
		}
	}
	\draw[->, very thick, blue!70!black] (-0.7,0.2) -- (-0.7,1.2) node[midway, left, font=\footnotesize] {$\vect B_0$};
	\draw[->, very thick] (0.2,1.95) -- (1.7,1.95) node[midway, above, font=\footnotesize] {$\vect k\perp\vect B_0$};
	\node[font=\footnotesize, red!70!black, anchor=east] at (6.3,2.05) {$\delta B,\ \delta\rho,\ \delta p$ у~фазі};
	% профіль B
	\draw[->] (-0.2,-0.6) -- (6.6,-0.6) node[right, font=\footnotesize] {$x$};
	\draw[very thick, red!70!black, domain=0:6.2, samples=80, variable=\x]
		plot ({\x},{-0.6+0.3*cos(\x*58.5)});
\end{tikzpicture}
