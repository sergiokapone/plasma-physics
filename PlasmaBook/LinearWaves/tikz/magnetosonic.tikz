\begin{tikzpicture}[>=latex']
	% силові лінії B0 (вертикальні), зміщені: лінії та плазма стискаються разом
	\foreach \i in {0,1,...,13} {
		\pgfmathsetmacro{\xs}{0.46*\i - 0.19*sin(\i*27.7)}
		\draw[blue!55, thick] (\xs,0) -- (\xs,1.5);
		\foreach \j in {1,3,5,7,9,11,13} {
			\fill[black!70] ({\xs + 0.04},{0.1*\j}) circle (0.7pt);
		}
	}
	\draw[->, very thick, blue!70!black] (-0.7,0.2) -- (-0.7,1.2) node[midway, left, font=\scriptsize] {$\vect B_0$};
	\draw[->, very thick] (0.2,1.9) -- (1.7,1.9) node[midway, above, font=\scriptsize] {$\vect k\perp\vect B_0$};
	% профіль B
	\draw[->] (-0.2,-0.5) -- (6.6,-0.5) node[right, font=\scriptsize] {$x$};
	\draw[very thick, red!70!black, domain=0:6.2, samples=80, variable=\x]
		plot ({\x},{-0.5+0.25*cos(\x*58.5)});
	\node[font=\scriptsize, red!70!black, anchor=west] at (6.6,-0.2) {$\delta B,\ \delta\rho,\ \delta p$ у~фазі};
\end{tikzpicture}
