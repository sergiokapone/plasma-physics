\begin{tikzpicture}[>=latex']
	% силові лінії, що коливаються поперек B0
	\foreach \y/\ph in {0.0/0, 0.45/0, 0.9/0, 1.35/0, 1.8/0} {
		\draw[blue!60!black, thick, domain=0:6.2, samples=80, variable=\x]
			plot ({\x},{\y + 0.28*sin(\x*90 - \ph)});
	}
	% B0
	\draw[->, very thick, blue!70!black] (-0.9,0.9) -- (-0.1,0.9) node[midway, above, font=\scriptsize] {$\vect B_0$};
	% напрямок поширення
	\draw[->, very thick] (0.2,2.55) -- (1.7,2.55) node[midway, above, font=\scriptsize] {$\vect k\parallel\vect B_0$};
	% векторні швидкості в двох точках
	\foreach \x in {1.0, 3.0, 5.0} {
		\pgfmathsetmacro{\yy}{0.9 + 0.28*sin(\x*90)}
		\pgfmathsetmacro{\vv}{0.28*cos(\x*90)*1.8}
		\draw[->, red!70!black, very thick] (\x,\yy) -- (\x,{\yy + \vv});
	}
	\node[font=\scriptsize, red!70!black, anchor=west] at (6.3,1.6) {$\delta\vect v_\perp,\ \delta\vect B_\perp$};
	% вісь z
	\draw[->] (0,-0.6) -- (6.5,-0.6) node[right, font=\scriptsize] {$z$};
\end{tikzpicture}
