\begin{tikzpicture}[>=latex']
	% силові лінії, що коливаються поперек B0
	\foreach \y in {0.0, 0.45, 0.9, 1.35, 1.8} {
		\draw[blue!60!black, thick, domain=0:6.2, samples=80, variable=\x]
			plot ({\x},{\y + 0.28*sin(\x*90)});
	}
	% B0
	\draw[->, very thick, blue!70!black] (-1.0,0.9) -- (-0.2,0.9) node[midway, above, font=\footnotesize] {$\vect B_0$};
	% напрямок поширення
	\draw[->, very thick] (0.2,2.65) -- (1.7,2.65) node[midway, above, font=\footnotesize] {$\vect k\parallel\vect B_0$};
	% швидкість максимальна там, де зміщення ліній нульове
	\foreach \x in {2.0, 4.0} {
		\pgfmathsetmacro{\vv}{0.55*cos(\x*90)}
		\draw[->, red!70!black, very thick] (\x,0.9) -- (\x,{0.9 + \vv});
	}
	\node[font=\footnotesize, red!70!black, anchor=west] at (4.1,1.3) {$\delta\vect v_\perp$};
	\node[font=\footnotesize, blue!60!black, anchor=west] at (6.3,1.8) {$\vect B_0+\delta\vect B_\perp$};
	% вісь z
	\draw[->] (0,-0.6) -- (6.5,-0.6) node[right, font=\footnotesize] {$z$};
\end{tikzpicture}
