\begin{tikzpicture}
	\begin{axis}[
		width=0.7\linewidth, height=0.38\linewidth,
		axis lines=middle, xmin=-6, xmax=6, ymin=-1.35, ymax=1.35,
		xlabel={$V$}, ylabel={$I$},
		every axis x label/.style={at={(current axis.right of origin)},anchor=west},
		every axis y label/.style={at={(current axis.north west)},above=2mm},
		xtick=\empty, ytick={-1,1}, yticklabels={$-I_{is}$,$I_{is}$},
		label style={font=\small}, ticklabel style={font=\small},
		clip=false]
		\addplot[very thick, blue!70!black, domain=-6:6, samples=80] {tanh(x/2)};
		\addplot[thick, red!70!black, dashed, domain=-2.4:2.4] {x/2};
		\draw[dotted] (axis cs:-6,1) -- (axis cs:6,1);
		\draw[dotted] (axis cs:-6,-1) -- (axis cs:6,-1);
		\node[font=\footnotesize, red!70!black, anchor=west] at (axis cs:1.6,0.35) {нахил $\dfrac{eI_{is}}{2T_e}$};
	\end{axis}
\end{tikzpicture}
