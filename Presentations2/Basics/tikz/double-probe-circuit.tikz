% Схема вимірювання подвійним зондом: коло з'єднує два електроди, зі стінкою камери зв'язку немає
\begin{tikzpicture}[>=latex, font=\small]
	% камера з плазмою
	\fill[violet!12] (0,0) rectangle (5.4,3);
	\draw[very thick] (0,0) rectangle (5.4,3);
	\node[font=\footnotesize, violet!60!black] at (2.7,0.45) {плазма};
	\node[font=\footnotesize, align=right, anchor=east] at (-0.15,1.5) {стінка камери\\(в~колі не\\бере участі)};
	% два однакові електроди
	\foreach \x/\n in {1.7/1, 3.7/2} {
		\draw[line width=3pt, gray!60] (\x,3.0) -- (\x,1.95);
		\draw[thick] (\x,3.9) -- (\x,3.0);
		\draw[line width=1.6pt, red!70!black] (\x,1.95) -- (\x,1.35);
		\fill[red!70!black] (\x,1.35) circle (0.07);
		\node[font=\footnotesize, anchor=west] at (\x+0.15,1.45) {$\n$};
	}
	% коло: електрод 1 -> амперметр -> джерело -> електрод 2
	\draw (1.7,3.9) -- (1.7,4.5) -- (2.0,4.5);
	\draw (2.6,4.5) -- (2.9,4.5);
	\draw (2.3,4.5) circle (0.3) node {A};
	\node[font=\footnotesize, anchor=south] at (2.3,4.85) {амперметр, $I$};
	\draw (2.9,4.5) -- (3.2,4.5);
	% джерело
	\draw[thick] (3.2,4.75) -- (3.2,4.25);
	\draw[thick] (3.35,4.62) -- (3.35,4.38);
	\draw (3.35,4.5) -- (3.7,4.5) -- (3.7,3.9);
	\draw[->, thick] (3.0,4.2) -- (3.6,4.85);
	\node[font=\footnotesize, anchor=west, align=left] at (3.9,4.5) {джерело\\напруги $V$};
	% потоки
	\draw[->, red!70!black, dashed] (0.7,1.1) -- (1.55,1.3);
	\node[font=\scriptsize, red!70!black, anchor=east] at (0.7,1.1) {$e^-$};
	\draw[->, blue!60!black, dashed] (2.7,1.0) -- (3.55,1.25);
	\node[font=\scriptsize, blue!60!black, anchor=east] at (2.7,1.0) {іони};
	% позначка: все коло плаває
	\node[font=\footnotesize, anchor=north, gray!50!black] at (2.7,-0.1) {коло плаває: ніде не заземлене};
\end{tikzpicture}
